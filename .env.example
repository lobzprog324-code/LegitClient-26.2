# Minecraft server
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=LobzikBot
# offline is only for a private server you own or are authorized to use.
# For Microsoft login use MC_AUTH=microsoft and complete the browser sign-in.
MC_AUTH=offline
# Leave blank for automatic protocol detection; or set 26.2 / 1.21.11 etc.
MC_VERSION=
# Recommended: set this to your Minecraft username to restrict chat commands.
BOT_OWNER=YourMinecraftName
DEFEND_RADIUS=8
# Off by default to avoid attacking other players.
ALLOW_PLAYER_COMBAT=false
AUTO_RECONNECT=true
